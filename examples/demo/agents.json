{
  "agents": [
    {
      "id": "coder",
      "name": "Code worker",
      "can": [
        {
          "action": "read",
          "target": "workspace/**"
        },
        {
          "action": "write",
          "target": "workspace/src/**"
        },
        {
          "action": "run",
          "command": "python --version"
        },
        {
          "action": "run",
          "command": "python -m pytest*"
        }
      ],
      "gate": [
        {
          "action": "write",
          "target": "pyproject.toml"
        },
        {
          "action": "run",
          "command": "git push*"
        },
        {
          "action": "run",
          "command": "*publish*"
        }
      ],
      "cannot": [
        {
          "action": "delete",
          "target": "**"
        },
        {
          "action": "run",
          "command": "Remove-Item*"
        },
        {
          "action": "run",
          "command": "rm -rf*"
        }
      ],
      "budget": {
        "tool_calls": 40,
        "minutes": 20
      }
    }
  ]
}
